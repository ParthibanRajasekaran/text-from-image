{
  "name": "@freetextfromimage/rendercheck",
  "version": "0.1.0",
  "description": "Verify that AI-generated UI shows the correct visible text using OCR and assertions",
  "keywords": ["ocr", "ui-verification", "ai", "testing", "playwright", "cypress", "rendercheck"],
  "license": "MIT",
  "author": "Parthiban Rajasekaran",
  "homepage": "https://freetextfromimage.com/rendercheck",
  "repository": {
    "type": "git",
    "url": "https://github.com/ParthibanRajasekaran/freetextfromimage",
    "directory": "packages/rendercheck"
  },
  "bugs": {
    "url": "https://github.com/ParthibanRajasekaran/freetextfromimage/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@freetextfromimage/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~5.8.2",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
