{
  "name": "text-from-image",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/git-hooks/install.js",
    "dev": "vite",
    "prebuild": "node scripts/validate-env.mjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender.mjs && node scripts/bundle-report.mjs",
    "check:copy": "node scripts/check-em-dashes.mjs && node scripts/check-claims.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "preview": "vite preview",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "sitemap": "node scripts/build-sitemap.mjs",
    "vendor:ocr": "node scripts/vendor-ocr-assets.mjs",
    "vendor:ocr:check": "node scripts/vendor-ocr-assets.mjs --check",
    "test:a11y": "vitest run src/**/*.a11y.spec.tsx --reporter=default",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "lint:a11y": "eslint . --max-warnings=0",
    "analyze": "ANALYZE=true npm run build",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check-legacy-shims": "node scripts/check-legacy-shims.mjs",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "verify:prod": "node scripts/verify-prod.mjs",
    "verify:full": "node scripts/verify-full.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "env:diff": "node scripts/env-diff.mjs",
    "vercel:link": "vercel link --yes",
    "vercel:pull:prod": "vercel pull --environment=production --yes",
    "spec:lint": "spectral lint specs/api/openapi.yml",
    "spec:diff": "oasdiff --fail-on-diff breaking specs/api/openapi.yml cached/openapi.yml || echo 'no previous'",
    "spec:schemas": "node scripts/validate-json.cjs",
    "spec:test": "playwright test -g '@bdd'"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^5.1.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.29",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
